<Window
    x:Class="Clicky.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Clicky"
    xmlns:controls="using:Clicky.Controls">
    <!--
      THE NOTCH — our own XAML recreation of the reference look:
      * Dynamic-Island-style pill, top-center of the screen, fully rounded
        (radius 28), solid ink #1C1E24, 8px from the top edge.
      * Collapsed: mascot + status line + live indicator + Talk button.
      * Expanded: cream #FFF3D6 card with the answer in Patrick Hand 20,
        butter #FFD84D next-step chips, and the question box (Barlow 14).
      * Expand/collapse animates with cubic-bezier(.4,.1,.3,1) (code-behind).
      * Live listening indicator (butter pulsing dot + waveform bars) is
        visible for the whole always-listening session.
      Nothing here is copied from the reference app — own XAML, own artwork,
      public OFL fonts, spec palette values.
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- WinUI 3 Window has no Resources property, so the notch's own
             converter + waveform storyboard live on the root Grid instead. -->
        <Grid.Resources>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <Storyboard x:Key="WaveStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 From="0.35" To="1" Duration="0:0:0.6" AutoReverse="True" />
                <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 From="1" To="0.35" Duration="0:0:0.6" BeginTime="0:0:0.2" AutoReverse="True" />
                <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 From="0.5" To="1" Duration="0:0:0.6" BeginTime="0:0:0.1" AutoReverse="True" />
                <DoubleAnimation Storyboard.TargetName="LiveDot" Storyboard.TargetProperty="Opacity"
                                 From="1" To="0.35" Duration="0:0:0.8" AutoReverse="True" />
            </Storyboard>
        </Grid.Resources>
        <Border CornerRadius="28" Background="{StaticResource InkBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Collapsed pill row -->
                <Grid Grid.Row="0" Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:MascotFace x:Name="Mascot" Grid.Column="0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                        <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource BarlowSemiBold}"
                                   FontSize="13" Foreground="White" />
                        <TextBlock Text="{Binding CaptionText}" FontFamily="{StaticResource Barlow}"
                                   FontSize="12" Foreground="White" Opacity="0.75"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>

                    <!-- Live listening indicator: visible for the whole ON session -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,8,0" Spacing="3"
                                Visibility="{Binding IsLiveSession, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse x:Name="LiveDot" Width="9" Height="9" Fill="{StaticResource ButterBrush}"
                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Rectangle x:Name="Bar1" Width="3" Height="14" Fill="{StaticResource ButterBrush}"
                                   RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar2" Width="3" Height="14" Fill="{StaticResource ButterBrush}"
                                   RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="1" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar3" Width="3" Height="14" Fill="{StaticResource ButterBrush}"
                                   RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.5" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <Button Content="Talk" Command="{Binding ToggleLiveSessionCommand}"
                                FontFamily="{StaticResource BarlowSemiBold}" FontSize="13"
                                Background="{StaticResource ButterBrush}" Foreground="{StaticResource InkBrush}"
                                CornerRadius="16" Padding="12,6" BorderThickness="0" />
                        <Button Content="End" Command="{Binding EndSessionCommand}"
                                FontFamily="{StaticResource BarlowSemiBold}" FontSize="13"
                                Background="{StaticResource CoralBrush}" Foreground="White"
                                CornerRadius="16" Padding="12,6" BorderThickness="0"
                                Visibility="{Binding IsLiveSession, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>

                <!-- Expanded card -->
                <Border Grid.Row="1" Background="{StaticResource CreamBrush}" CornerRadius="20"
                        Margin="8,0,8,8" Padding="14,12"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding AnswerText}" FontFamily="{StaticResource PatrickHand}"
                                       FontSize="20" Foreground="{StaticResource InkBrush}"
                                       TextWrapping="Wrap" LineHeight="26" />

                            <TextBlock Text="Next steps" FontFamily="{StaticResource BarlowSemiBold}"
                                       FontSize="12" Foreground="{StaticResource GreyColor}" />
                            <ItemsControl ItemsSource="{Binding NextSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding ElementName=RootGrid, Path=DataContext.NextStepCommand}"
                                                CommandParameter="{Binding}"
                                                FontFamily="{StaticResource BarlowMedium}" FontSize="13"
                                                Background="{StaticResource ButterBrush}" Foreground="{StaticResource InkBrush}"
                                                CornerRadius="14" Padding="10,6" BorderThickness="0"
                                                HorizontalAlignment="Left" Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="QuestionBox" Grid.Column="0"
                                         Text="{Binding QuestionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Ask about your screen…"
                                         FontFamily="{StaticResource Barlow}" FontSize="14"
                                         Background="White" Foreground="{StaticResource InkBrush}"
                                         CornerRadius="14" Padding="10,8" BorderThickness="0" />
                                <Button Grid.Column="1" Content="Ask" Command="{Binding AskCommand}"
                                        FontFamily="{StaticResource BarlowSemiBold}" FontSize="13"
                                        Background="{StaticResource InkBrush}" Foreground="White"
                                        CornerRadius="14" Padding="14,8" BorderThickness="0" />
                            </Grid>

                            <Button Content="Close" Command="{Binding DismissCommand}"
                                    FontFamily="{StaticResource Barlow}" FontSize="12"
                                    Background="Transparent" Foreground="{StaticResource GreyColor}"
                                    HorizontalAlignment="Right" BorderThickness="0" Padding="8,4" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
