<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>Clicky</AssemblyName>
    <RootNamespace>Clicky</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged WinUI 3 app: runs from the publish folder, no MSIX install, no signing. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clicky.Core\Clicky.Core.csproj" />
    <ProjectReference Include="..\Clicky.Drawing\Clicky.Drawing.csproj" />
    <ProjectReference Include="..\Clicky.Agents\Clicky.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Assets\*.png" />
    <Content Include="Assets\Fonts\*.ttf" />
    <!-- backend.json is read at startup from the folder next to Clicky.exe. -->
    <Content Include="..\..\backend.json">
      <Link>backend.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The solution build generates resources.pri (the app's resource index,
       which holds the compiled window layout), but dotnet publish does not
       deliver it to the publish folder, so the window can never load at
       runtime (XamlParseException). Copy it in after publish when it exists. -->
  <Target Name="CopyResourcesPri" AfterTargets="Publish">
    <Message Text="CopyResourcesPri: checking $(MSBuildProjectDirectory)\bin\x64\$(Configuration)\$(TargetFramework)\win-x64\resources.pri" Importance="high" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\bin\x64\$(Configuration)\$(TargetFramework)\win-x64\resources.pri" DestinationFolder="$(PublishDir)" Condition="Exists('$(MSBuildProjectDirectory)\bin\x64\$(Configuration)\$(TargetFramework)\win-x64\resources.pri')" />
  </Target>

  <!-- dotnet build / publish never generate resources.pri at all for this
       unpackaged app (run #24 proved it exists nowhere), so make it with
       MakePri (Windows SDK) after publish, using the build's own
       priconfig.xml, and place it next to Clicky.exe. -->
  <Target Name="GenerateResourcesPri" AfterTargets="Publish">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\make-pri.ps1&quot; -PublishDir &quot;$(PublishDir)&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -IntermediateOutputPath &quot;$(IntermediateOutputPath)&quot;" />
  </Target>

</Project>
