<Application
    x:Class="Clicky.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Fonts: public OFL releases bundled in Assets/Fonts (never the reference app's files). -->
            <FontFamily x:Key="Barlow">ms-appx:///Assets/Fonts/Barlow-Regular.ttf#Barlow</FontFamily>
            <FontFamily x:Key="BarlowMedium">ms-appx:///Assets/Fonts/Barlow-Medium.ttf#Barlow Medium</FontFamily>
            <FontFamily x:Key="BarlowSemiBold">ms-appx:///Assets/Fonts/Barlow-SemiBold.ttf#Barlow SemiBold</FontFamily>
            <FontFamily x:Key="PatrickHand">ms-appx:///Assets/Fonts/PatrickHand-Regular.ttf#Patrick Hand</FontFamily>

            <!-- Palette: the observable TONES values (see docs/ui-visual-spec.md). -->
            <Color x:Key="InkColor">#1C1E24</Color>
            <Color x:Key="InkSoftColor">#30333A</Color>
            <Color x:Key="GreyColor">#7E838D</Color>
            <Color x:Key="ButterColor">#FFD84D</Color>
            <Color x:Key="SunColor">#FFB930</Color>
            <Color x:Key="CoralColor">#F2706B</Color>
            <Color x:Key="RedColor">#E5484D</Color>
            <Color x:Key="VioletColor">#6E5BD8</Color>
            <Color x:Key="SkyColor">#5AA8F5</Color>
            <Color x:Key="BlueColor">#1F5FCC</Color>
            <Color x:Key="MintColor">#7ED6A0</Color>
            <Color x:Key="LeafColor">#3E9E5C</Color>
            <Color x:Key="CreamColor">#FFF3D6</Color>
            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
            <SolidColorBrush x:Key="CreamBrush" Color="{StaticResource CreamColor}" />
            <SolidColorBrush x:Key="ButterBrush" Color="{StaticResource ButterColor}" />
            <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}" />
            <SolidColorBrush x:Key="GreyBrush" Color="{StaticResource GreyColor}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
